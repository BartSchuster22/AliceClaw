{
  "name": "psi-platform",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "docker compose up --build",
    "stop": "docker compose down",
    "logs": "docker compose logs -f",
    "db:migrate": "pnpm --filter @psi/db migrate",
    "db:seed": "pnpm --filter @psi/db seed"
  }
}
